<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_initial_background"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/widget_preview_data_unavailable"
        android:textColor="@color/widget_initial_primary_text"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="2" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/widget_preview_data_hint"
        android:textColor="@color/widget_initial_secondary_text"
        android:textSize="10sp"
        android:maxLines="3" />
</LinearLayout>
