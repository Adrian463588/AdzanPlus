<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_location_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jakarta"
        android:textColor="#88D6B7"
        android:textSize="11sp"
        android:textStyle="bold"
        android:singleLine="true" />

    <TextView
        android:id="@+id/widget_next_prayer_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="DZUHUR"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_target_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="12:05 WIB"
        android:textColor="#BFC9C3"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Chronometer
        android:id="@+id/widget_countdown_chronometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_pill_bg"
        android:countDown="true"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:textColor="#FAC248"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
